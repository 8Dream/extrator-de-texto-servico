# A interface e o conversor funcionam sem ligar o trabalhador de GPU.
{
	order sablier before reverse_proxy
	admin off
	auto_https off
}

:8110 {
	respond /favicon.ico 204

	@web {
		method GET HEAD
		path / /web/estilo.css /web/extrator.js
	}
	handle @web {
		header {
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options "nosniff"
		}
		root * /srv
		rewrite / /web/index.html
		file_server
	}

	handle /documentos/* {
		reverse_proxy extrator-documentos:8111
	}

	handle {
		route {
			sablier http://sablier:10000 {
				names extrator-servico
				session_duration 15m
				blocking {
					timeout 5m
				}
			}
			reverse_proxy extrator-servico:8110 {
				flush_interval -1
			}
		}
	}
}
